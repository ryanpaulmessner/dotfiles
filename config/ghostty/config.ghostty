# Ghostty: main terminal on macOS. tmux does panes/tabs; Ghostty only draws.
# Machine-only lines go in ~/.config/ghostty/config.local (not in the repo).

# Look: Tokyo Night with the brighter colours carried over from the old WezTerm config
theme = TokyoNight Night
background = #14151c
foreground = #d0daf5
palette = 0=#2a2f44
palette = 1=#ff9db4
palette = 2=#c3f991
palette = 3=#ffd580
palette = 4=#97c2ff
palette = 5=#d7bdff
palette = 6=#a3e5ff
palette = 7=#f5f5f5
palette = 8=#545c7e
palette = 9=#ffb3c9
palette = 10=#dcffb0
palette = 11=#ffe9a3
palette = 12=#b8d7ff
palette = 13=#ebd5ff
palette = 14=#c9f3ff
palette = 15=#ffffff

font-family = FiraCode Nerd Font
font-family = JetBrains Mono
font-size = 11
font-feature = calt
font-feature = liga

window-padding-x = 4
window-padding-y = 4
macos-titlebar-style = hidden
macos-non-native-fullscreen = true
cursor-style = bar
cursor-style-blink = true

# Keys: left Option is Alt/Meta, right Option types special characters
macos-option-as-alt = left
keybind = shift+insert=paste_from_clipboard
keybind = super+shift+c=copy_to_clipboard
keybind = super+shift+v=paste_from_clipboard

# Leader Ctrl+Space for Ghostty splits/tabs, same letters as tmux and nvim (no timeout).
# Ctrl+Space twice sends Ctrl+Space (NUL) to the program, e.g. blink.cmp completion.
keybind = ctrl+space>ctrl+space=text:\x00
keybind = ctrl+space>h=goto_split:left
keybind = ctrl+space>j=goto_split:down
keybind = ctrl+space>k=goto_split:up
keybind = ctrl+space>l=goto_split:right
keybind = ctrl+space>ctrl+h=resize_split:left,40
keybind = ctrl+space>ctrl+j=resize_split:down,40
keybind = ctrl+space>ctrl+k=resize_split:up,40
keybind = ctrl+space>ctrl+l=resize_split:right,40
keybind = ctrl+space>s=new_split:down
keybind = ctrl+space>v=new_split:right
keybind = ctrl+space>shift+apostrophe=new_split:down
keybind = ctrl+space>shift+five=new_split:right
keybind = ctrl+space>z=toggle_split_zoom
keybind = ctrl+space>equal=equalize_splits
keybind = ctrl+space>x=close_surface
keybind = ctrl+space>c=new_tab
keybind = ctrl+space>tab=last_tab
keybind = ctrl+space>n=next_tab
keybind = ctrl+space>p=previous_tab
keybind = ctrl+space>one=goto_tab:1
keybind = ctrl+space>two=goto_tab:2
keybind = ctrl+space>three=goto_tab:3
keybind = ctrl+space>four=goto_tab:4
keybind = ctrl+space>five=goto_tab:5
keybind = ctrl+space>six=goto_tab:6
keybind = ctrl+space>seven=goto_tab:7
keybind = ctrl+space>eight=goto_tab:8
keybind = ctrl+space>nine=goto_tab:9

copy-on-select = clipboard
confirm-close-surface = false

# zsh-vi-mode sets the cursor shape; do not let shell integration fight it
shell-integration-features = no-cursor

config-file = ?config.local
